# PostgreSQL connection string. Leave empty to use apps/api/data/site-data.json.
# Examples:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/shop_flower
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Set to true for cloud PostgreSQL providers that require SSL.
DATABASE_SSL=false

PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_PASSWORD=admin123
