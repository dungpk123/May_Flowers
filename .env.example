# TiDB/MySQL connection string. Leave empty to use apps/api/data/site-data.json.
# Examples:
# DATABASE_URL=mysql://user:password@host:4000/sys
# DATABASE_NAME=shop_flower
DATABASE_URL=
DATABASE_NAME=shop_flower

# Set to true for TiDB Cloud.
DATABASE_SSL=true

PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_PASSWORD=admin123

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push for the admin PWA. Generate once with:
# npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@mayflowers.shop
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
